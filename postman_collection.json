{
  "info": {
    "name": "Executive Brand Automation API",
    "description": "Complete API collection for testing the Executive Brand Automation platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ceo@techcorp.com\",\n  \"password\": \"SecurePass123!\",\n  \"full_name\": \"Jean Dupont\",\n  \"company\": \"Tech Corp France\",\n  \"position\": \"CEO\",\n  \"tier\": \"professional\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ceo@techcorp.com\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Voice Profile",
      "item": [
        {
          "name": "Analyze Voice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"samples\": [\n    \"En 20 ans à diriger des entreprises tech, j'ai appris qu'innover ne consiste pas à être le premier, mais à avoir raison. Les meilleurs leaders ne suivent pas les tendances, ils les créent.\",\n    \"Le paysage business d'aujourd'hui exige plus que du leadership traditionnel. Nous avons besoin d'executives capables de combiner pensée stratégique et empathie, data et intuition.\",\n    \"Voici ce que personne ne vous dit sur le scaling : Les processus qui vous ont amené à 10M€ vont exploser à 50M€. Construisez pour là où vous allez, pas pour là où vous êtes.\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/voice/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["voice", "analyze"]
            }
          }
        },
        {
          "name": "Get Voice Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/voice/profile",
              "host": ["{{baseUrl}}"],
              "path": ["voice", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Content",
      "item": [
        {
          "name": "Generate LinkedIn Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"L'avenir de l'IA dans le leadership d'entreprise\",\n  \"contentType\": \"linkedin_post\",\n  \"tone\": \"thought-provoking\",\n  \"additionalContext\": \"Focus sur applications pratiques, pas le hype\",\n  \"includeHashtags\": true,\n  \"targetAudience\": \"C-level executives en tech et finance\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/content/generate",
              "host": ["{{baseUrl}}"],
              "path": ["content", "generate"]
            }
          }
        },
        {
          "name": "Generate Twitter Thread",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Les 5 erreurs de leadership que j'ai commises en scaling de 1M à 100M\",\n  \"contentType\": \"twitter_thread\",\n  \"tone\": \"authentic\",\n  \"includeHashtags\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/content/generate",
              "host": ["{{baseUrl}}"],
              "path": ["content", "generate"]
            }
          }
        },
        {
          "name": "List Content",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/content?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["content"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Trends",
      "item": [
        {
          "name": "Get Trending Topics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trends?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["trends"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Content Ideas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/content/ideas?topic=leadership",
              "host": ["{{baseUrl}}"],
              "path": ["content", "ideas"],
              "query": [
                {
                  "key": "topic",
                  "value": "leadership"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Scheduling",
      "item": [
        {
          "name": "Schedule Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentId\": 1,\n  \"socialAccountId\": 1,\n  \"scheduledTime\": \"2025-12-27T09:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/schedule",
              "host": ["{{baseUrl}}"],
              "path": ["schedule"]
            }
          }
        },
        {
          "name": "Get Scheduled Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/schedule",
              "host": ["{{baseUrl}}"],
              "path": ["schedule"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    }
  ]
}
